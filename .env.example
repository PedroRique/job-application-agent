# App lock. SESSION_SECRET: openssl rand -base64 32
# APP_PASSWORD must be at least 8 characters. SESSION_SECRET at least 16.
APP_PASSWORD=
SESSION_SECRET=

# OpenAI. Server-side only. Vision + structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Supabase. Server-side only. Do not use the anon key in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts the Microsoft token cache at rest. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Azure app registration for personal Microsoft accounts.
# Delegated permissions: Mail.Send and User.Read.
# Redirect URI must match this value exactly.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
